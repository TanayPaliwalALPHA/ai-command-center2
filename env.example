# Copy to .env.local. Server-side only: never prefix with NEXT_PUBLIC_.
# Set at least one key; the router only uses providers that have keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
# Optional model overrides (check each provider's current model list)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-5-5
XAI_MODEL=grok-4
PERPLEXITY_MODEL=sonar-pro
